# Database (Neon / Supabase / cualquier Postgres)
# Ejemplo Neon: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET=

# URL pública de la app (local o Vercel)
# Local: http://localhost:3000
# Preview: https://tu-app.vercel.app
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — magic links por email (https://resend.com)
# From debe ser un dominio verificado en Resend (o onboarding@resend.dev en pruebas)
AUTH_RESEND_KEY=
EMAIL_FROM="Mi Regreso al Gym <onboarding@resend.dev>"
